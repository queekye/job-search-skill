        "同步配置/交接由本人网页完成；无多人并行或离线合并写入"
      ],
      "recipes": [
        {
          "tool": "career_get",
          "operation": "sync.status",
          "args": {},
          "purpose": "只读当前同步模式"
        },
        {
          "command": "python scripts/run.py backup --output <private-backup.zip> --data-dir <private-data-dir>",
          "purpose": "停止服务后完整备份；不是 MCP 写操作"
        }
      ],
      "evidence": {
        "scope": "source_contract",
        "browser_acceptance": "not_asserted",
        "real_site": "not_asserted",
        "installed_plugin": "not_asserted"
      }
    }
