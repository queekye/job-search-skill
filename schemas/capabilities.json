        "状态无变化保持安静；不会变更现有自动化"
      ],
      "recipes": [
        {
          "tool": "career_schedule",
          "action": "get",
          "purpose": "读取绑定账号的配置"
        },
        {
          "tool": "career_schedule",
          "action": "prepare",
          "purpose": "获得一次检查用提示词；本操作不建立自动化"
        }
      ],
      "evidence": {
        "scope": "source_contract",
        "browser_acceptance": "not_asserted",
        "real_site": "not_asserted",
        "installed_plugin": "not_asserted"
      }
    },
    {
      "id": "migration_sync",
      "name": "迁移与个人同步",
      "description": "区分结构化交换、完整离线备份与私有 WebDAV 单写者交接。",
      "status": "configuration",
      "entry": {
        "skill": "career",
        "tool": "career_get",
        "operation": "sync.status"
      },
      "requires": [
        "私人数据目录位于源码、运行包及云同步目录之外",
        "完整恢复前停止旧服务；写入遵循同步所有权"
      ],
      "limitations": [
